# Copy this file to .env and replace every required value before starting Compose.
POSTGRES_DB=NOVA
POSTGRES_USER=novatech
POSTGRES_PASSWORD=

# Generate a random 32-byte Base64 key. In PowerShell:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET_BASE64=

# Optional first-run super administrator bootstrap. Uncomment and fill these
# for the first startup only, then remove them from .env after the account is created.
# Password must contain at least 12 characters, including uppercase, lowercase, and a number.
# ADMIN_INITIAL_EMAIL=admin@example.com
# ADMIN_INITIAL_PASSWORD=Choose-A-Strong-Password-123
# ADMIN_INITIAL_NAME=Administrateur NovaTech

FRONTEND_PORT=3000
API_PORT=8081
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173
PUBLIC_SITE_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8081/api/v1
