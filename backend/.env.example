# PostgreSQL (create the database before starting the API)
DB_URL=jdbc:postgresql://localhost:5432/NOVA
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Local profile updates the schema. Use SPRING_PROFILES_ACTIVE=prod in production.
SPRING_PROFILES_DEFAULT=dev
JPA_DDL_AUTO=update
SERVER_PORT=8081

# Restrict this list to the deployed frontend origins in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Create a random 32-byte (or longer) secret and Base64-encode it before enabling JWT.
# PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# JWT_SECRET_BASE64=
JWT_ISSUER=novatech-solution
JWT_ACCESS_TOKEN_TTL=PT30M
JWT_REFRESH_TOKEN_TTL=PT8H
PASSWORD_RESET_TOKEN_TTL=PT30M
PUBLIC_POSTS_PER_MINUTE=10
PUBLIC_POST_WINDOW=PT1M
PUBLIC_SITE_URL=http://localhost:5173
# Set these once to create the first super administrator; no demo account is generated.
# ADMIN_INITIAL_EMAIL=admin@example.com
# ADMIN_INITIAL_PASSWORD=Choose-A-Strong-Password-123
# ADMIN_INITIAL_NAME=Administrateur NovaTech


# Upload limits
MEDIA_MAX_FILE_SIZE=10MB
MEDIA_MAX_REQUEST_SIZE=12MB
